# 复制本文件为 .env 并填入真实值（也可直接在应用侧边栏中配置）
#
# DeepSeek 开放平台 API Key：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-api-key-here

# OpenAI 兼容接口地址（DeepSeek 官方默认值）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名：deepseek-flash（当前 DeepSeek-V4.1-Flash，默认推荐）
#   deepseek-v4-pro = DeepSeek-V4-Pro；旧名 deepseek-v4-flash 仍可用（由 V4.1-Flash 接管）
# 也可换成任意 OpenAI 兼容平台的模型名，例如：
#   火山方舟：   ep-2024xxxx / deepseek-v3-0324   （Base URL: https://ark.cn-beijing.volces.com/api/v3）
#   SiliconFlow：deepseek-ai/DeepSeek-V3          （Base URL: https://api.siliconflow.cn/v1）
DEEPSEEK_MODEL=deepseek-flash

# 可选：采样温度与输出上限
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=2048

# 可选：思考模式（DeepSeek V4 专属）：true 开启 / false 关闭 / 留空跟随模型默认
# deepseek-flash 默认开启思考，本应用生成结构化 JSON 建议设为 false（更快更省）
DEEPSEEK_THINKING=false
